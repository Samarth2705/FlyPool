# Copy this file to ".env" (ignored by git) and adjust if needed.
# EXPO_PUBLIC_ variables are built into the app, so never put secrets here.

# The FlyPool API, including /api.
#   Production:         https://fly-pool-eta.vercel.app/api
#                       (the website's Vercel project forwards /api/* to the
#                       backend project, https://fly-pool-hqpt.vercel.app/api)
#   Local server:       http://<your computer's LAN IP>:5000/api
#                       (a phone can't reach "localhost" on your computer)
EXPO_PUBLIC_API_URL=https://fly-pool-eta.vercel.app/api
