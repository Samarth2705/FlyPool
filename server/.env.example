# Copy this file to ".env" and fill in real values.
# Never commit the real .env file.

NODE_ENV=development
PORT=5000

# MongoDB Atlas connection string (Atlas -> Connect -> Drivers)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/flypool?retryWrites=true&w=majority

# Long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string
JWT_EXPIRES_IN=1d

# The React app's URL (used for CORS)
CLIENT_ORIGIN=http://localhost:5173

# true only when served over HTTPS (production)
COOKIE_SECURE=false
