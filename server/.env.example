# Copy this file to ".env" (same folder) and fill in the values.
# The real .env file is ignored by git - never commit it.

# development | production   (default: development)
NODE_ENV=

# Port for the API   (default: 5000)
PORT=

# REQUIRED - MongoDB Atlas connection string (Atlas -> Connect -> Drivers)
MONGODB_URI=

# REQUIRED - long random string (at least 32 characters). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# How long a website login lasts, e.g. 1d, 12h   (default: 1d)
JWT_EXPIRES_IN=

# How long a mobile app login lasts, e.g. 30d   (default: 30d)
JWT_MOBILE_EXPIRES_IN=

# Push notifications via Expo's push service: "true" to send them
# (default: off). Needs an EAS project and FCM/APNs credentials for delivery.
EXPO_PUSH_ENABLED=
# Only if "enhanced push security" is on for the Expo project
EXPO_ACCESS_TOKEN=

# Payments: "demo" (simulated - no money moves) or "off".
# Default: demo in development, off in production. No real provider yet.
PAYMENT_MODE=
# Secret that payment webhooks are signed with (HMAC-SHA256, header
# X-Razorpay-Signature). Without it the webhook endpoint refuses all events.
PAYMENT_WEBHOOK_SECRET=

# URL of the React app, used for CORS   (default: http://localhost:5173)
CLIENT_ORIGIN=

# true only when the site is served over HTTPS   (default: false)
COOKIE_SECURE=

# ---- Production / deployment ----------------------------------------------
# In production (NODE_ENV=production) the server refuses to start without
# CLIENT_ORIGIN and COOKIE_SECURE=true.

# lax (default) | strict | none. Use "none" only if the app and the API are on
# different sites; it requires COOKIE_SECURE=true.
COOKIE_SAME_SITE=

# Number of proxies in front of the API (load balancer / hosting router), so
# rate limits see real client IPs. false (default) | true | 1 | 2 ...
TRUST_PROXY=

# One log line per request (method, path, status, time - never bodies).
# Default: true (false when NODE_ENV=test)
LOG_REQUESTS=

# ---- Flight verification ---------------------------------------------------
# demo = consistency checks only (format, airline code, date) - NOT a real
#        flight lookup; shown as "demo verification" in the app.
# off  = verification refused with a clear error.
# Default: demo in development, off in production. No real flight-data
# provider is connected yet (see README).
FLIGHT_VERIFICATION_MODE=

# Give up on a verification service after this many milliseconds (default 10000)
VERIFICATION_TIMEOUT_MS=

# Reading an uploaded ticket (decode, barcode, OCR / PDF text) gives up after
# this many milliseconds (default 20000)
DOCUMENT_READ_TIMEOUT_MS=

# Identity verification through an authorised KYC provider. Default: off -
# no provider is connected, starting a check is refused and nobody is shown
# as identity-verified. FlyPool never receives identity documents; the
# provider sends only the result to POST /api/identity/webhook, signed with
# IDENTITY_WEBHOOK_SECRET (HMAC-SHA256, header X-Identity-Signature).
# ("sandbox" is the automated tests' stand-in and is refused outside NODE_ENV=test.)
IDENTITY_PROVIDER=
IDENTITY_WEBHOOK_SECRET=
