{
  "name": "flypool-server",
  "version": "1.0.0",
  "description": "FlyPool REST API - Express + MongoDB",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch-path=src --watch-path=.env src/server.js",
    "start": "node src/server.js",
    "test": "node --test \"test/**/*.test.js\"",
    "seed:demo": "node src/seed/demoTravellers.js",
    "migrate:pools": "node src/migrations/2026-10-shared-pools.js",
    "check:data": "node src/scripts/checkData.js",
    "test:unit": "node --test \"test/unit/*.test.js\"",
    "test:integration": "node --test --test-concurrency=1 \"test/integration/*.test.js\""
  },
  "type": "module",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.1",
    "zod": "^4.6.5"
  },
  "engines": {
    "node": ">=20"
  },
  "private": true,
  "devDependencies": {
    "mongodb-memory-server": "^10.1.4"
  }
}
