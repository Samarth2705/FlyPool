# Optional. Copy this file to ".env" only if you need to change it.
# The real .env file is ignored by git - never commit it.
# Note: every VITE_ variable ends up in the browser, so never put secrets here.

# Base URL of the API   (default: /api, which the Vite dev proxy forwards
# to the Express server - see vite.config.js)
VITE_API_BASE_URL=
